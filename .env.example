PORT=3333
DATABASE_URL=postgresql://postgres:panteratech@localhost:5432/dashboardhml

# Deixe em branco (ou "development") em homologação. Em produção, defina
# como "production" — isso desliga o `devCode` na resposta de
# /auth/signup/start (ver README, seção "Verificação por SMS").
NODE_ENV=development

# Gere segredos aleatórios longos, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=5cc909b1d12e762f90c6b8b0d8f07cc8160ce3c5b2af27510eb850945f0c61924d3f87a9d2ce580908f5a620de60ed29
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# '*' reflete qualquer origem (bom pro Expo em dev). Em produção, liste
# os domínios reais separados por vírgula.
CORS_ORIGIN=*
"@ | Out-File -FilePath .env -Encoding utf8 -NoNewline