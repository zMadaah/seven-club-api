PORT=3333
DATABASE_URL=postgresql://postgres:SUASENHA@localhost:5432/sevenclub_homolog

# Deixe em branco (ou "development") em homologação. Em produção, defina
# como "production" — isso desliga o `devCode` na resposta de
# /auth/signup/start (ver README, seção "Verificação por SMS").
NODE_ENV=development

# Gere um segredo aleatório longo, nunca reaproveite um valor que já
# apareceu em qualquer lugar (chat, documentação, etc.) — trate qualquer
# valor exposto como comprometido:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=troque_por_um_segredo_aleatorio_longo
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# '*' reflete qualquer origem (bom pro Expo em dev). Em produção, liste
# os domínios reais separados por vírgula.
CORS_ORIGIN=*
