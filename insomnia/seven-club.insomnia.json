      "method": "POST",
      "url": "{{ _.base_url }}/auth/signup/start",
      "metaSortKey": -960,
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"name\": \"Maria Teste\",\n  \"email\": \"maria@sevenclub.com\",\n  \"phone\": \"+5511999999999\"\n}"
      }
    },
    {
      "_id": "req_signup_resend",
      "_type": "request",
      "parentId": "fld_cadastro",
      "name": "1b. Reenviar código (opcional)",
