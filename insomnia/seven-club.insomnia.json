      "method": "POST",
      "url": "{{ _.base_url }}/auth/signup/resend",
      "metaSortKey": -950,
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        }
      ],
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"signupId\": \"{{ _.signup_id }}\"\n}"
      }
